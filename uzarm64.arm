// =============================================================================
// For code blocks & comments comparison:
//    sed -e "s,// ,; ," -e "s,^//,;," -i uzarm64.arm
//    sed -e "s,; ,// ," -e "s,^;,//," -i uzarm64.arm
// ==============================================================================
// Compiling:
//    aarch64-linux-gnu-as -o uzarm64.o uzarm64.arm &&
//        aarch64-linux-gnu-objcopy -O binary uzarm64.o uzarm64
// Testing qemu:
//    aarch64-linux-gnu-gcc -static -s -x c hello.c -o hiarm64 &&
//        qemu-aarch64-static $PWD/hiarm64 && echo $?
// Testing uzarm64:
//    chmod +x uzarm64 && strace qemu-aarch64-static $PWD/uzarm64
//        echo $? && du -b uzarm64
//    cc -s -static hello.c -o hix86s && file hix86s &&
//        cp -f uzarm64 hix86z && gzip -9c hix86s >> hix86z &&
//            qemu-aarch64-static -d strace $PWD/hix86z && echo $?
// Alternative:
//    use '-d strace' for a quick and simple system call tracing
// =============================================================================

.text
.global _start
.equ BASE_ADDR, 0x00400000              // Loading base definition

// ==============================================================================
// ELF64 HEADER (Micro-Loader a 64-bit, Teeny ELF)
// ==============================================================================
elf_header:
  .byte 0x7F,'E','L','F',2,1,1,0        // e_ident (Magic, Class 64bit, LSB, Version)
.fill 8, 1, 0                           // Padding e_ident
  .short 2                              // e_type (ET_EXEC, Executable)
  .short 183                            // e_machine (EM_AARCH64, ARM AArch64)
  .word 1                               // e_version
  .quad BASE_ADDR + 120                 // e_entry (Salto matematico sicuro a main_start)
  .quad 64                              // e_phoff (Il Program Header inizia a offset 64)
  .quad 0                               // e_shoff
  .word 0                               // e_flags
  .short 64                             // e_ehsize
  .short 56                             // e_phentsize
  .short 1                              // e_phnum
  // ----------------------------------------------------------------------------
  // Many Linux kernel ELF parsers completely ignore these 6
  // bytes when section offset e_shoff = 0, as in this case.
  .short 0                              // e_shentsize
  .short 0                              // e_shnum
  .short 0                              // e_shstrndx

phdr:
  .word 1                               // p_type = PT_LOAD
  .word 7                               // p_flags (PF_R + PF_W + PF_X)
  .quad 0                               // p_offset
  .quad BASE_ADDR                       // p_vaddr
  .quad BASE_ADDR                       // p_paddr
  .quad file_end - elf_header           // p_filesz (file size)
  .quad file_end - elf_header + 1024    // p_memsz  (file size + buf size)
  .quad 0x1000                          // p_align

  // ----------------------------------------------------------------------------
  // p_flags (PF_R + PF_W + PF_X)

  // Security-by-Design VS Security-by-Subtraction

  // Because uzpexec contains no input parsing logic that could be corrupted and
  // its fixed 512-byte read loop cannot be overflowed, the writeable-executable
  // segment offers no exploitable attack vector. They are 1024 in aarm64 binary.

  // Since the loader immediately forfeits control through atomic fork() / exec()
  // or execveat() transitions that never return, an attacker cannot redirect
  // execution to modified code before the process image is replaced.

  // An adversary who can already write to the process memory holds sufficient
  // privileges to inject code via ptrace or mprotect on any standard binary,
  // which means the R+W+X flag introduces zero additional risk.

  // WRX is the least of your troubles, but uzpexec as obscenely-powerful tool.

// ==============================================================================
// CODE (uzpexec stub execution starts here)
// ==============================================================================
main_start:
  // This would be the main() in a C-language sourcemain_start
  // Save original argv and calculate envp from the initial stack layout
  // Stack: [argc] [argv[0]] ... [argv[N]] [NULL] [envp...]
  ldr x21, [sp]                         // x21 = argc     (from the stack start)
  add x19, sp, #8                       // x19 = &argv[0] (pointer to argv array)
  // envp starts right after the NULL terminating argv.
  add x20, x19, x21, lsl #3             // x20 = x19 + (argc * 8)
  add x20, x20, #8                      // x20 = envp (skips the NULL terminator)

  // ----------------------------------------------------------------------------
  // HARDENING: NO_NEW_PRIVS & ANTI-CORE-DUMP
  // 
  // Using umask() is omitted because memfd ignores filesystem permissions.
  // Additional hardening:
  // - prctl(NO_NEW_PRIVS) prevents SUID escalation,
  // - prctl(PR_SET_DUMPABLE, 0) prevents core dumps,
  // - F_SEAL_SEAL locks the memfd seals permanently,
  // - MFD_CLOEXEC and F_SEAL_WRITE are already set.
  // ----------------------------------------------------------------------------

  // prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0)
  mov x8, #167                          // SYS_prctl
  mov x0, #38                           // PR_SET_NO_NEW_PRIVS
  mov x1, #1                            // enable
  mov x2, #0
  mov x3, #0
  svc #0

  // prctl(PR_SET_DUMPABLE, 0, 0, 0, 0)
//mov x8, #167                          // SYS_prctl, aready set
  mov x0, #4                            // PR_SET_DUMPABLE
  mov x1, #0                            // disable
//mov x2, #0                            // already set
//mov x3, #0                            // already set
  svc #0

  // ===========================================================================

  // 1. Try to open itself file by /proc/self/exe
  mov x8, #56                           // SYS_openat
  movn x0, #99                          // AT_FDCWD
  adr x1, commd_exe                     // /proc/self/exe
  movz x2, #8, lsl #16                  // O_RDONLY | O_CLOEXEC
  svc #0
  mov x22, x0                           // Move FD in X22 to save it for later

  // 2. Try to open the memfd, as first operation
  mov x8, #279                          // SYS_memfd_create
  adr x0, filename                      // Linux requires a name here
  mov x1, #3                            // MFD_CLOEXEC | MFD_ALLOW_SEALING
  svc #0
  mov x23, x0                           // X23 = [memfd]

  // Organising the stack in the proper order (inverse order of popping)
  adr x24, buf                          // X24 = buf

  // 3. Try to read from the file the 1st block + 4 bytes to check the carryload
  mov x8, #63                           // SYS_read
  mov x0, x22                           // input FD
  mov x1, x24                           // Buffer
  mov x2, #512                          // read size = file size
  svc #0

  // 4b. Fork the process
  mov x8, #220                          // SYS_clone (no flags = biological fork)
  mov x0, #17                           // SIGCHLD
  mov x1, #0
  mov x2, #0
//mov x3, #0                            // already set
  svc #0
  cbz x0, child                         // the child jump to its routine

  // ============================================================================
  // PARENT PROCESS ( p::stack { [memfd], buf, filename, 0 } )
  // ============================================================================
parent:
  // 1p. The parent waits for the child completes zcat writing in memfd
  mov x8, #260                          // SYS_wait4
  mov x0, #-1                           // any child
//mov x1, #0                            //            already set
//mov x2, #0                            //            already set
//mov x3, #0                            // No rusage, already set
  svc #0
  cmn x0, #4                            // check for EINTR (-4)
  b.eq parent                           // -EINTR, try again

  // ----------------------------------------------------------------------------
  // HARDENING: F_ADD_SEALS TO MEMFD
  // 
  // Apply F_ADD_SEALS (F_SEAL_WRITE, etc.) to the memfd exclusively
  // within the ELF execution path before invoking execveat().
  // 
  // - ELF hardening: prevents any runtime exploits from tampering with
  //  or rewriting the binary payload resident in RAM via /proc/self/fd/.
  // 
  // - Script compatibility: this security measure is omitted for the
  //  shell interpreter branch because /bin/sh and its sub-utilities
  //  often require standard read/write descriptors or create temporary
  //  files, meaning write-restricted seals could break compatibility.
  // ----------------------------------------------------------------------------
  // 2p. Sealing the memfd/ELF in RO mode, for security and integrity
  mov x8, #25                           // SYS_fcntl
  mov x0, x23                           // memfd
  mov x1, #1033                         // F_ADD_SEALS (0x0409)
  // F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL = 15 (0x0f)
  mov x2, #15                           // protected FD (0x0f)
  svc #0

  // ----------------------------------------------------------------------------
  // ELF BINARY MODE (Security: harden ELF execution via read-only memfd seals)
  // ----------------------------------------------------------------------------

  // 3s. Spawns a /bin/sh whose STDIN is piped to zcat, passing original argvs
  mov x8, #221                          // SYS_execve

  // Prepare "/proc/self/fd/9" in commd_exe
  adr  x0, commd_exe                    // /proc/self/exe -> fd/9
  mov  w1, #0x6466                      // 'f','d' (little-endian)
  movk w1, #0x342f, lsl #16             // '/','4' ('0' + 4 = 0x34)
  str  w1, [x0, #11]                    // overwrite "exe\0" with "fd/4"

  // In-place stack manipulation: build new argv starting at argc slot
  // New argv: ["/bin/sh", "/proc/self/fd/9", original_args...]
  mov x1, x19                           // x1 = argv (original)
  mov x2, x20                           // x2 = envp (original)

.do_int:
  svc #0
  b exit_error

// ============================================================================
// CHILD PROCESS ( c::stack { [memfd], buf, filename, 0 } )
// ============================================================================
child:
  // 1c. 1st dup2: connect input (EDI) to STDIN (0) for both modes
  mov x8, #24                           // SYS_dup3
  mov x0, x22                           // input FD
//mov x1, #0                            // STDIN, already set
  mov x2, #0
  svc #0

  // 2c. 2nd dup2: connect output to STDOUT (1) of the child which is MEMFD
//mov x8, #24                           // SYS_dup3, already set
  mov x0, x23                           // zcat writes in memfd
  mov x1, #1                            // STDOUT
//mov x2, #0                            // already set
  svc #0

  // 3c. Execute zcat passing "-f" when reading from the STDIN (**)
  mov x8, #221                          // SYS_execve

  // In x86: pop ecx (buf), pop ebx (filename), add ebx, zcat_path-filename
  // Here: x24 = buf (was set before fork), calculate zcat_path dynamically
  adr x0, filename
  add x0, x0, #(zcat_path - filename)   // zcat_path = filename + strlen(filename)
  str xzr, [sp, #-8]!                   // end of envp/argv (push 0)
  str x0, [sp, #-8]!                    // push zcat_path --> argv[0]
  mov x1, sp                            // argv[1...]
//mov x2, #0                            // envp null
  svc #0

  // ============================================================================
exit_error:
  // Print copyright notice, version and internal name
  adr x1, copy_vers
.ifdef _DO_EXTRA
  mov x2, #(zcat_path - copy_vers - 1)  // bytes to write
  mov w3, ' '                           // space
.else
  mov x2, #(provider - copy_vers)       // bytes to write
  mov w3, '\n'                          // line feed
.endif
  strb w3, [x1, #(provider - copy_vers - 1)]
  mov x8, #64                           // SYS_write
  mov x0, #1                            // stdout
  svc #0

  mov x8, #93                           // SYS_exit
  mov x0, #1                            // Exit code 1
  svc #0

// ==============================================================================
// COMPACT DATA SECTION (appended to code)
// ==============================================================================
// filename can be changed by sed up to 7 chars + ending \0
// zcat -f is cat when input isn't gzip, options up to -6c\0
// /bin/zcat can be changed by sed up to 41 chars + ending \0
// - for example: /usr/local/bin/xzcat is 20 chars + ending \0
// in do_script mode the 2 paths shrink to 20 chars + ending \0
// eof_strng helps to find the EOF, and where \0 padding starts
//                                                                 LN | XE
copy_vers:  .ascii "(c) github/robang74 v0.38 "                //  26 | 26
filename :  .ascii      "uzarm64\0"                            //   8 |  8
provider :  .ascii      "12345678\n\0"                         //  10 | 10
//following fields are conditionally overwritable, do unions   //  ---------  44
zcat_path:  .ascii         "/bin/zcat\0\0"                     //  12 | 17
eof_tests:  .ascii "U238\0"                                    //   5 |  -
// This introduces the need of having the /proc mounted, granted after the /init
// The shorter alernative is /dev/fd/9, but it is NOT grated on embedded systems
commd_exe:  .ascii "/proc/self/exe\0"                          //  15 | 15
empty_str:  .ascii "\0"                                        //   1 |  1
//              |<-- 8 chars -->|<- +8c ->|                    //  ---------  33 
                                                               //  77 (tot.)  77

// ==============================================================================
// PADDING: Aligned exactly to 1024 bytes (dd skip=2)
// ==============================================================================
file_end:                               // Physical end of the binary file!
.fill (512 - (. - elf_header)), 1, 0   // Padding to 1024 bytes for skip=2

// ==============================================================================
// BSS SECTION (RAM only)
// ==============================================================================
buf:                                    // Label at offset 1024, RAM only
.equ bss_end, . + 512                   // Reserve 512 bytes for the buffer

