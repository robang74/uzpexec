.text
.global _start

.equ BASE_ADDR, 0x00400000              // Definizione pura della base di caricamento

// ==============================================================================
// ELF64 HEADER (Struttura lineare a 64-bit senza overlapping)
// ==============================================================================
elf_header:
  .byte 0x7F, 'E', 'L', 'F', 2, 1, 1, 0 // e_ident (Magic, Class 64bit, LSB, Version)
  .fill 8, 1, 0                         // Padding e_ident
  .short 2                              // e_type (Executable)
  .short 183                            // e_machine (ARM AArch64)
  .word 1                               // e_version
  .quad BASE_ADDR + main_start          // e_entry (64-bit entry point)
  .quad phdr - elf_header               // e_phoff (Offset Program Header)
  .quad 0                               // e_shoff (No Section Header Table)
  .word 0                               // e_flags
  .short 64                             // e_ehsize (Size di questo header ELF64)
  .short 56                             // e_phentsize (Size di un Program Header entry)
  .short 1                              // e_phnum (Un solo segmento)
  .short 0, 0, 0                        // Section info (zeroed)

phdr:
  .word 1                               // p_type (PT_LOAD)
  .word 7                               // p_flags (R+W+X) - Preservato AS-IS
  .quad 0                               // p_offset
  .quad BASE_ADDR                       // p_vaddr
  .quad BASE_ADDR                       // p_paddr
  .quad file_end - elf_header           // p_filesz
  .quad file_end - elf_header + 516     // p_memsz
  .quad 0x1000                          // p_align (Allineamento standard)

// ==============================================================================
// CODE (uzpexec stub execution per ARM64)
// ==============================================================================
main_start:
  // Al boot su ARM64 Linux:
  // X0 = argc
  // SP = punta ad argv[0], argv[1], ...
  mov x21, x0                           // Salva argc in X21 (equivalente concettuale di EAX originale)
  mov x19, sp                           // X19 = argv (il nostro vecchio ESI)

  // Calcolo di envp: EBP = argv + (argc * 8) + 8
  lsl x0, x21, #3                       // argc * 8 (puntatori a 64-bit)
  add x0, x0, #8
  add x20, x19, x0                      // X20 = envp (il nostro vecchio EBP, callee-saved)

  // ----------------------------------------------------------------------------
  // HARDENING: NO_NEW_PRIVS & ANTI-CORE-DUMP (Identico all'originale)
  // ----------------------------------------------------------------------------
  // prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0)
  mov x8, #167                          // SYS_prctl su ARM64
  mov x0, #38                           // PR_SET_NO_NEW_PRIVS
  mov x1, #1                            // abilita
  mov x2, #0
  mov x3, #0
  svc #0

  // prctl(PR_SET_DUMPABLE, 0, 0, 0, 0)
  mov x8, #167                          // SYS_prctl
  mov x0, #4                            // PR_SET_DUMPABLE
  mov x1, #0                            // disabilita
  svc #0

  // Recupero argv[0] per tentare l'apertura
  ldr x1, [x19]                         // X1 = argv[0]

  // ============================================================================
  // 1. Apri se stesso tramite openat (ARM64 non ha SYS_open)
  mov x8, #56                           // SYS_openat
  movn x0, #99                          // AT_FDCWD (Emula open partendo dalla dir corrente)
  // X1 contiene già argv[0]
  movz x2, #8, lsl #16                  // O_RDONLY | O_CLOEXEC
  svc #0
  mov x22, x0                           // Ripone l'input FD in X22 (il nostro vecchio EDI)

  // 2. Crea il memfd
  mov x8, #279                          // SYS_memfd_create su ARM64
  ldr x0, =filename                     // Nome descrittivo
  mov x1, #1                            // MFD_CLOEXEC
  svc #0
  mov x23, x0                           // X23 = [memfd]

  // Prepara l'area buffer nello stack/BSS per simulare la struttura originale
  ldr x24, =buf                         // X24 = indirizzo del buffer

  // 3. Loop di lettura del primo blocco di 516 byte
  mov x2, #516                          // Size iniziale da leggere
.read_loop:
  mov x8, #63                           // SYS_read su ARM64
  mov x0, x22                           // Input FD
  mov x1, x24                           // Buffer
  svc #0
  cmp x0, #0
  b.le .stdin                           // Se <= 0 (errore o EOF), passa a STDIN
  sub x2, x2, x0
  cbnz x2, .read_loop
  b .fork_now

.stdin:
.ifdef _NO_STDIN
  b exit_error
.else
  mov x22, #0                           // X22 = 0 (STDIN)
.endif

.fork_now:
  // 4a. Riposiziona il puntatore del file a 512 se stavamo leggendo da file
  mov x8, #62                           // SYS_lseek su ARM64
  mov x0, x22                           // Input FD
  mov x1, #512                          // Offset
  mov x2, #0                            // SEEK_SET
  svc #0

  // 4b. Fork del processo tramite SYS_clone (Fork classica è spesso omessa o deprecata su ARM64)
  mov x8, #220                          // SYS_clone (senza flag equivale a una fork biologica)
  mov x0, #17                           // SIGCHLD nell'argomento dei flag
  mov x1, #0
  mov x2, #0
  mov x3, #0
  mov x4, #0
  svc #0
  cbz x0, child                         // Se 0, siamo nel processo figlio

  // ============================================================================
  // PARENT PROCESS
  // ============================================================================
parent:
  // 1p. Attesa del figlio via wait4 (ARM64 non ha waitpid nativo autonomo)
  mov x8, #260                          // SYS_wait4
  mov x0, #-1                           // Qualunque processo figlio
  mov x1, #0
  mov x2, #0
  mov x3, #0                            // No rusage
  svc #0

  // 2p. Harden memfd aggiungendo i sigilli di protezione (F_ADD_SEALS)
  mov x8, #92                           // SYS_fcntl su ARM64
  mov x0, x23                           // FD del nostro memfd
  mov x1, #1033                         // F_ADD_SEALS (0x0409)
  mov x2, #15                           // F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL
  svc #0

.rewind_memfd:
  // 3p. Rewind del memfd a 0
  mov x8, #62                           // SYS_lseek
  mov x0, x23
  mov x1, #0
  mov x2, #0
  svc #0

  // 4p. Legge i primi 4 byte per capire se è uno script o un ELF
  mov x8, #63                           // SYS_read
  mov x0, x23
  mov x1, x24                           // Buffer temporaneo
  mov x2, #4
  svc #0

  // 5p. Verifica il Magic dell'ELF (\x7FELF)
  ldr w0, [x24]
  ldr w1, =0x464c457f                   // Little-Endian per \x7FELF
  cmp w0, w1
  b.eq .execute_elf

  // ----------------------------------------------------------------------------
  // SCRIPT MODE
  // ----------------------------------------------------------------------------
  // 1s. Riposiziona il memfd a 0 per la shell
  mov x8, #62                           // SYS_lseek
  mov x0, x23
  mov x1, #0
  mov x2, #0
  svc #0

  // 2s. Duplica il memfd sul descrittore di sistema 9 tramite dup3 (ARM64 non ha dup2)
  mov x8, #24                           // SYS_dup3
  mov x0, x23                           // Da memfd
  mov x1, #9                            // A FD 9
  mov x2, #0                            // No flags (comportamento identico a dup2)
  svc #0

  // 3s. Esecuzione shell: sostituzione parametri in-place nello stack
  // Per fedeltà assoluta sovrascriviamo la struttura logica
  adr x0, do_script
  str x0, [x19, #0]                     // argv[0] = "/bin/sh"
  adr x1, commd_arg
  str x1, [x19, #8]                     // argv[1] = "-c"
  adr x1, commd_src
  str x1, [x19, #16]                    // argv[2] = ". /proc/self/fd/9"

  mov x8, #221                          // SYS_execve su ARM64
  adr x0, do_script
  mov x1, x19                           // Nuovo argv manipolato
  mov x2, x20                           // envp originale
  svc #0
  b exit_error

  // ----------------------------------------------------------------------------
  // ELF BINARY MODE
  // ----------------------------------------------------------------------------
.execute_elf:
  mov x8, #281                          // SYS_execveat su ARM64
  mov x0, x23                           // target FD (memfd)
  adr x1, empty_string                  // Path vuoto ""
  mov x2, x19                           // argv originale
  mov x3, x20                           // envp originale
  mov x4, #0x1000                       // AT_EMPTY_PATH
  svc #0
  b exit_error

// ============================================================================
// CHILD PROCESS
// ============================================================================
child:
  // 1c. Collega l'input FD (X22) allo STDIN (0) tramite dup3
  mov x8, #24                           // SYS_dup3
  mov x0, x22
  mov x1, #0                            // STDIN
  mov x2, #0
  svc #0

  // 2c. Collega il memfd (X23) allo STDOUT (1) tramite dup3
  mov x8, #24                           // SYS_dup3
  mov x0, x23
  mov x1, #1                            // STDOUT
  mov x2, #0
  svc #0
  cmp x0, #0
  b.lt exit_error

  // 3c. Execute zcat passing "-f" when reading from the STDIN (**)
  sub sp, sp, #32
  adr x0, zcat_path
  str x0, [sp, #0]                      // argv[0] = zcat_path

  ldrh w1, [x24]
  mov w2, #0x8b1f                       // match Little-Endian per GZIP (0x1F, 0x8B)
  cmp w1, w2
  b.eq .ok_force                        // be strict on gzip input (no -f option)
.ifdef _NO_FORCE
  b exit_error                          // the -f option could be completely excluded
.else
  cbnz x22, .no_force                   // zcat reading from file can't be relaxed (-f)
.endif
.ok_force:
  adr x1, force_arg
  str x1, [sp, #8]                      // argv[1] = "-f"
  str xzr, [sp, #16]                    // NULL terminator
  b .do_exec_child
.no_force:
  str xzr, [sp, #8]                     // NULL terminator

.do_exec_child:
  mov x8, #221                          // SYS_execve
  // X0 contiene già zcat_path
  mov x1, sp                            // Il nostro array argv locale
  mov x2, #0                            // envp NULL
  svc #0

// ============================================================================
// EXIT / ERROR HANDLING
// ============================================================================
exit_error:
  mov x8, #64                           // SYS_write su ARM64
  mov x0, #2                            // Stderr
  adr x1, copy_vers
  mov x2, #26                           // Lunghezza stringa stimata
  svc #0

  mov x8, #93                           // SYS_exit su ARM64
  mov x0, #1                            // Exit code 1
  svc #0

// ==============================================================================
// COMPACT DATA SECTION (appended to code)
// ==============================================================================
// filename can be changed by sed up to 7 chars + ending \0
// zcat -f is cat when input isn't gzip, options up to -6c\0
// /bin/zcat can be changed by sed up to 41 chars + ending \0
// - for example: /usr/local/bin/xzcat is 20 chars + ending \0
// in do_script mode the 2 paths shrink to 20 chars + ending \0
// eof_strng helps to find the EOF, and where \0 padding starts
//                                                                  LN | FD |  SH
copy_vers:  .ascii "(c) github/robang74 v0.92 "                 //  26 | 26 |  26
filename :  .ascii      "uzprm64\0"                             //   8 |  8 |   8
provider :  .ascii      "12345678\n\0"                          //  10 | 10 |  10
zcat_path:  .ascii         "/bin/zcat\0"                        //  11 | 42 |  21
            .fill 10, 1, 0                                      //  10 |  - |  -
do_script:  .ascii "/bin/sh\0"                                  //  16 |  - |  21
              .fill 8, 1, 0
eof_tests:  .ascii "U238\0"                                     //   5 |  - |   -
commd_arg:  .ascii "-c\0"                                       //   3 |  - |   3
// This introduces the need of having the /proc mounted, granted after the /init
// The shorter alernative is /dev/fd/9, but it is NOT grated on embedded systems
.ifdef _USE_DEVFS
commd_src:  .ascii ". /dev"
.else
commd_src:  .ascii ". /proc/self"
.endif
            .ascii "/fd/9\0"                                     //  18 |  - |  18
force_arg:  .ascii "-f\0"                                        //   3 |  3 |   3
//              |<-- 8 chars -->|<- +8c ->|                      //  ---------  45
                                                                 // 110 (tot.) 110

// ==============================================================================
// PADDING: Aligned exactly to 1024 bytes (dd skip=1)
// ==============================================================================
file_end:                       // Physical end of the binary file!
.fill (1024 - (. - elf_header) -24), 1, 0  // Padding to 1024 bytes for skip=1

// ==============================================================================
// BSS SECTION (RAM-only)
// ==============================================================================
buf:                                    // Etichetta agganciata subito dopo i 1024 byte
