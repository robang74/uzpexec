// =============================================================================
// For code blocks & comments comparison:
//    sed -e "s,^//,;," -e "s,// ,; ," -i uzpexec.arm
//    sed -e "s,^;,//," -e "s,// ,; ," -i uzpexec.arm
// ==============================================================================
// Compiling:
//    aarch64-linux-gnu-as -o uzprm64.o uzpexec.arm &&
//    aarch64-linux-gnu-objcopy -O binary uzprm64.o uzprm64
// Testing qemu:
//    aarch64-linux-gnu-gcc -static -s -x c hello.c -o hiarm64 &&
//    qemu-aarch64-static ./hiarm64; echo $?
// Testing uzpexec:
//    chmod +x uzprm64 && strace qemu-aarch64-static ./uzprm64 <&-
//    cp -f uzprm64 hzarm64 && cat hiarm64 >> hzarm64
//    strace qemu-aarch64-static ./hzarm64; echo $?
// =============================================================================

.text
.global _start
.equ BASE_ADDR, 0x00400000              // Loading base definition

// ==============================================================================
// ELF64 HEADER (Micro-Loader a 64-bit, Teeny ELF)
// ==============================================================================
elf_header:
  .byte 0x7F,'E','L','F',2,1,1,0        // e_ident (Magic, Class 64bit, LSB, Version)
.fill 8, 1, 0                           // Padding e_ident
  .short 2                              // e_type (ET_EXEC, Executable)
  .short 183                            // e_machine (EM_AARCH64, ARM AArch64)
  .word 1                               // e_version
  .quad BASE_ADDR + 120                 // e_entry (Salto matematico sicuro a main_start)
  .quad 64                              // e_phoff (Il Program Header inizia a offset 64)
  .quad 0                               // e_shoff
  .word 0                               // e_flags
  .short 64                             // e_ehsize
  .short 56                             // e_phentsize
  .short 1                              // e_phnum
  // ----------------------------------------------------------------------------
  // Many Linux kernel ELF parsers completely ignore these 6
  // bytes when section offset e_shoff = 0, as in this case.
  .short 0                              // e_shentsize
  .short 0                              // e_shnum
  .short 0                              // e_shstrndx

phdr:
  .word 1                               // p_type = PT_LOAD
  .word 7                               // p_flags (PF_R + PF_W + PF_X)
  .quad 0                               // p_offset
  .quad BASE_ADDR                       // p_vaddr
  .quad BASE_ADDR                       // p_paddr
  .quad 1024                            // p_filesz (file size)
  .quad 1024 + 516                      // p_memsz  (file size + buf size)
  .quad 0x1000                          // p_align

  // p_flags (PF_R + PF_W + PF_X)
  // ----------------------------------------------------------------------------
  // Security-by-Design VS Security-by-Subtraction

  // Because uzpexec contains no input parsing logic that could be corrupted and
  // its fixed 512-byte read loop cannot be overflowed, the writeable-executable
  // segment offers no exploitable attack vector.

  // Since the loader immediately forfeits control through atomic fork() / exec()
  // or execveat() transitions that never return, an attacker cannot redirect
  // execution to modified code before the process image is replaced.

  // An adversary who can already write to the process memory holds sufficient
  // privileges to inject code via ptrace or mprotect on any standard binary,
  // which means the R+W+X flag introduces zero additional risk.

  // WRX is the least of your troubles, but uzpexec as obscenely-powerful tool.

// ==============================================================================
// CODE (uzpexec stub execution starts here)
// ==============================================================================
main_start:
.ifdef _SAY_HELLO //////////////////////////////////////////////////////////////
    mov x8, #64         // SYS_write su ARM64 è 64!
    mov x0, #2          // Canale 2 = stderr
    adr x1, hello_msg   // Puntatore alla stringa
    mov x2, #13         // Lunghezza esatta di "Hello ARM64!\n"
    svc #0              // Invocazione kernel
    mov x8, #93         // SYS_exit su ARM64 è 93
    mov x0, #0          // Exit code 0
    svc #0
hello_msg:
    .ascii "Hello ARM64!\n"
.endif /////////////////////////////////////////////////////////////////////////
  // This would be the main() in a C-language sourcemain_start
  // Save original argv and calculate envp from the initial stack layout
  // Stack: [argc] [argv[0]] ... [argv[N]] [NULL] [envp...]
  mov x21, x0                           // argc (was X0)
  mov x19, sp                           // X19 = argv

  lsl x0, x21, #3                       // argc * 8 (64-bit pointers)
  add x0, x0, #8
  add x20, x19, x0                      // X20 = envp (callee-saved!)

  // ----------------------------------------------------------------------------
  // HARDENING: NO_NEW_PRIVS & ANTI-CORE-DUMP
  // 
  // Using umask() is omitted because memfd ignores filesystem permissions.
  // Additional hardening:
  // - prctl(NO_NEW_PRIVS) prevents SUID escalation,
  // - prctl(PR_SET_DUMPABLE, 0) prevents core dumps,
  // - F_SEAL_SEAL locks the memfd seals permanently,
  // - MFD_CLOEXEC and F_SEAL_WRITE are already set.
  // ----------------------------------------------------------------------------

  // prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0)
  mov x8, #167                          // SYS_prctl
  mov x0, #38                           // PR_SET_NO_NEW_PRIVS
  mov x1, #1                            // enable
  mov x2, #0
  mov x3, #0
  svc #0

  // prctl(PR_SET_DUMPABLE, 0, 0, 0, 0)
  mov x8, #167                          // SYS_prctl
  mov x0, #4                            // PR_SET_DUMPABLE
  mov x1, #0                            // disable
  svc #0

  // Checking argv[0] to open input (itself or stdin)
  ldr x1, [x19]                         // CVE-2021-4034, pre-5.18, can't cover LK bugs
                                        // Let SIGSEGV do the work and/or syscalls fail

  // ===========================================================================

  // 1. Try to open itself file by argv[0] (CVE-2021-4034, ends here)
  // X1 contains argv[0]
  mov x8, #56                           // SYS_openat
  movn x0, #99                          // AT_FDCWD
  movz x2, #8, lsl #16                  // O_RDONLY | O_CLOEXEC
  svc #0
  mov x22, x0                           // Move fd in X22 to save it for later

  // 2. Try to open the memfd, as first operation
  mov x8, #279                          // SYS_memfd_create
  adr x0, filename                      // Linux requires a name here
  mov x1, #1                            // MFD_CLOEXEC
  svc #0
  mov x23, x0                           // X23 = [memfd]

  // Organising the stack in the proper order (inverse order of popping)
  adr x24, buf                          // X24 = buf

  // 3. Try to read from the file the 1st block + 4 bytes to check the carryload
  mov x2, #516                          // read size (512+4), 64-bit aligned
.read_loop:
  mov x8, #63                           // SYS_read
  mov x0, x22                           // input fd
  mov x1, x24                           // Buffer
  svc #0
  cmp x0, #0
  b.le .stdin                           // if read fails, read STDIN
  sub x2, x2, x0
  cbnz x2, .read_loop
  b .fork_now

.stdin:
.ifdef _NO_STDIN
  b exit_error                          // single point of detour
.else
  mov x22, #0                           // X22 = 0 (STDIN)
.endif

.fork_now:
  // 4a. File pointer set
  mov x8, #62                           // SYS_lseek
  mov x0, x22                           // input fd
  mov x1, #512                          // offset = 512
  mov x2, #0                            // SEEK_SET = 0
  svc #0

  // 4b. Fork the process
  mov x8, #220                          // SYS_clone (no flags = biological fork)
  mov x0, #17                           // SIGCHLD
  mov x1, #0
  mov x2, #0
  mov x3, #0
  mov x4, #0
  svc #0
  cbz x0, child                         // the child jump to its routine

  // ============================================================================
  // PARENT PROCESS ( p::stack { [memfd], buf, filename, 0 } )
  // ============================================================================
parent:
  // 1p. The parent waits for the child completes zcat writing in memfd
  mov x8, #260                          // SYS_wait4
  mov x0, #-1                           // any child
  mov x1, #0
  mov x2, #0
  mov x3, #0                            // No rusage
  svc #0

  // 2p. Closing the real file once read in full, also for safety,
  //     but fd is RD_ONLY so we can save bytes here, avoiding it.
  //     Expecially because with O_CLOEXEC, it lasts just a little
  // test edi, edi
  // jz .rewind_memfd
  // push 6                              ; SYS_close
  // pop eax
  // mov ebx, edi
  // int 0x80

  // ----------------------------------------------------------------------------
  // HARDENING: F_ADD_SEALS TO MEMFD
  // 
  // Apply F_ADD_SEALS (F_SEAL_WRITE, etc.) to the memfd exclusively
  // within the ELF execution path before invoking execveat().
  // 
  // - ELF hardening: prevents any runtime exploits from tampering with
  //   or rewriting the binary payload resident in RAM via /proc/self/fd/.
  // 
  // - Script compatibility: this security measure is omitted for the
  //   shell interpreter branch because /bin/sh and its sub-utilities
  //   often require standard read/write descriptors or create temporary
  //   files, meaning write-restricted seals could break compatibility.
  // ----------------------------------------------------------------------------
  // 2p. Sealing the memfd/ELF in RO mode, for security and integrity
  mov x8, #92                           // SYS_fcntl
  mov x0, x23                           // memfd
  mov x1, #1033                         // F_ADD_SEALS (0x0409)
  // F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL = 15 (0x0f)
  mov x2, #15                           // write only fd
  svc #0

.rewind_memfd:
  // 3p. Rewind memfd at the starting point to check for the shebang script
  mov x8, #62                           // SYS_lseek
  mov x0, x23
  mov x1, #0                            // offset = 0
  mov x2, #0                            // SEEK_SET = 0
  svc #0

  // 4p. Read the first uncompressed 4 bytes (just two for the shebang)
  mov x8, #63                           // SYS_read
  mov x0, x23
  mov x1, x24                           // Buffer
  mov x2, #4                            // count = 4
  svc #0

  // 5p. Check about ELF magic chars sequence (\x7FELF)
  //     A 32-bit comparison is shorter, safer and faster
  //     compared with checking for the shebang (optional)
  ldr w0, [x24]
// !!! fa inserire all’assemblatore un literal pool (4 byte sdi dati
//     nel .text) che rompe il conteggio dei 1024 byte e sposta tutto.
//ldr w1, =0x464c457f                   // Match Little-Endian
  mov  w1, #0x457f
  movk w1, #0x464c, lsl #16
  cmp w0, w1
  b.eq .execute_elf                     // If ELF, do execve()

  // ----------------------------------------------------------------------------
  // SCRIPT MODE
  // ----------------------------------------------------------------------------
  // 1s. Rewind memfd at the starting point to pass it to the shell
  mov x8, #62                           // SYS_lseek
  mov x0, x23
  mov x1, #0                            // offset = 0
  mov x2, #0                            // SEEK_SET = 0
  svc #0

  // 2s. Connect the memfd to the shell STDIN (fd 0)
  mov x8, #24                           // SYS_dup3
  mov x0, x23                           // from memfd
  mov x1, #9                            // to FD 9
  mov x2, #0                            // No flags
  svc #0

  // 3s. Spawns a /bin/sh whose STDIN is piped to zcat, passing original argvs
  // In-place stack manipulation using ESP (argv is at [esp]):
  // ["/bin/sh", "-c", ". /dev/fd/9", "--", original_args...]

  // Safeguard: if argc is 0 <-- No, the issue was argv=NULL, SIGSEGV solves
  // Therefore the branch "no_args" would never traversed and can be removed

  // In-place stack manipulation using ESP (argv is at [esp]):
  // ["/bin/sh", "-c", ". /dev/fd/9", "--", original_args...]

  // Build new argv in-place: overwrite first 4 slots, shift original args
  adr x0, do_script
  str x0, [x19, #0]                     // argv[0] = "/bin/sh"
  adr x0, commd_arg
  str x0, [x19, #8]                     // argv[1] = "-c"
  adr x0, commd_src
  str x0, [x19, #16]                    // argv[2] = ". /proc/self/fd/9"
  adr x0, dashdash
  str x0, [x19, #24]                    // argv[3] = "--"

  // Copy original argv[1]..argv[argc] (incl. NULL) to argv[4..]
  add x1, x19, #32                      // dest = &argv[4]
  add x2, x19, #8                       // src = &argv[1]
  mov x3, x21                           // count = argc
.copy_args:
  ldr x0, [x2], #8
  str x0, [x1], #8
  subs x3, x3, #1
  b.ne .copy_args

  // basic operations for calling the execve()
  mov x8, #221                          // SYS_execve
  adr x0, do_script
  mov x1, x19                           // argv (manipulated)
  mov x2, x20                           // envp (intact from main_start)
  svc #0
  b exit_error                          // eventually will fail later

  // ----------------------------------------------------------------------------
  // ELF BINARY MODE (Security: harden ELF execution via read-only memfd seals)
  // ----------------------------------------------------------------------------
.execute_elf:
  // Execute the ELF binary using a Linux specific syscall
  mov x8, #281                          // SYS_execveat
  mov x0, x23                           // memfd
  adr x1, empty_string                  // ""
  mov x2, x19                           // argv (original)
  mov x3, x20                           // envp (original)
  mov x4, #0x1000                       // AT_EMPTY_PATH
  svc #0
  b exit_error                          // never returns unless syscall fails

// ============================================================================
// CHILD PROCESS ( c::stack { [memfd], buf, filename, 0 } )
// ============================================================================
child:
  // 1c. 1st dup2: connect input (EDI) to STDIN (0) for both modes
  mov x8, #24                           // SYS_dup3
  mov x0, x22                           // input FD
  mov x1, #0                            // STDIN
  mov x2, #0
  svc #0

  // 2c. 2nd dup2: connect output to STDOUT (1) of the child which is MEMFD
  mov x8, #24                           // SYS_dup3
  mov x0, x23                           // zcat writes in memfd
  mov x1, #1                            // STDOUT
  mov x2, #0
  svc #0
  cmp x0, #0
  b.lt exit_error

  // 3c. Execute zcat passing "-f" when reading from the STDIN (**)
  mov x8, #221                          // SYS_execve

  // In x86: pop ecx (buf), pop ebx (filename), add ebx, zcat_path-filename
  // Here: x24 = buf (was set before fork), calculate zcat_path dynamically
  adr x0, filename
  add x0, x0, #(zcat_path - filename)   // zcat_path = filename + strlen(filename)

  str xzr, [sp, #-8]!                   // end of envp/argv (push 0)
         
  ldrh w1, [x24]
  mov w2, #0x8b1f                       // match Little-Endian per GZIP (0x1F, 0x8B)
  cmp w1, w2
  b.eq .ok_force                        // be strict on gzip input (no -f option)
  cbz x22, .ok_force                    // zcat reading from STDIN can be relaxed (-f)
.ifdef _NO_FORCE
  b exit_error                          // the -f option could be completely excluded
.else
  b .no_force                           // zcat reading from STDIN can be relaxed (-f)
.endif

.ok_force:
  adr x1, force_arg                     // "-f"
  str x1, [sp, #-8]!                    // push "-f"

.no_force:
  str x0, [sp, #-8]!                    // push zcat_path --> argv[0]
  mov x1, sp                            // argv[1...]
  mov x2, #0                            // envp null
  svc #0

  // ============================================================================
exit_error:
// test ebx, ebx
// jnz exit_now

  // Print copyright notice, version and internal name
  adr x1, copy_vers
.ifdef _DO_EXTRA
  mov x2, #(zcat_path - copy_vers - 1)  // bytes to write
  mov w3, #32
  strb w3, [x1, #(zcat_path - copy_vers - 1 - 10)]
.else
  mov x2, #(provider - copy_vers)       // bytes to write
  mov w3, #10
  strb w3, [x1, #(provider - copy_vers - 1)]
.endif
  mov x8, #64                           // SYS_write
  mov x0, #2                            // stderr
  svc #0

// exit_now:
// xor ebx, ebx
// inc ebx                              // Exit code 1
  mov x8, #93                           // SYS_exit
  mov x0, #1                            // Exit code 1
  svc #0

// ==============================================================================
// COMPACT DATA SECTION (appended to code)
// ==============================================================================
// filename can be changed by sed up to 7 chars + ending \0
// zcat -f is cat when input isn't gzip, options up to -6c\0
// /bin/zcat can be changed by sed up to 41 chars + ending \0
// - for example: /usr/local/bin/xzcat is 20 chars + ending \0
// in do_script mode the 2 paths shrink to 20 chars + ending \0
// eof_strng helps to find the EOF, and where \0 padding starts
//                                                                 LN | FD |  SH
copy_vers:  .ascii "(c) github/robang74 v0.92 "                //  26 | 26 |  26
filename :  .ascii      "uzprm64\0"                            //   8 |  8 |   8
provider :  .ascii      "12345678\n\0"                         //  10 | 10 |  10
zcat_path:  .ascii         "/bin/zcat\0"                       //  11 | 42 |  21
            .fill 10, 1, 0                                     //  10 |  - |  -
do_script:  .ascii "/bin/sh\0"                                 //  16 |  - |  21
            .fill 8, 1, 0
eof_tests:  .ascii "U238\0"                                    //   5 |  - |   -
commd_arg:  .ascii "-c\0"                                      //   3 |  - |   3
// This introduces the need of having the /proc mounted, granted after the /init
// The shorter alernative is /dev/fd/9, but it is NOT grated on embedded systems
.ifdef _USE_DEVFS
commd_src:  .ascii ". /dev"
.else
commd_src:  .ascii ". /proc/self"
.endif
            .ascii "/fd/9\0"                                   //  18 |  - |  18
force_arg:  .ascii "-f\0"                                      //   3 |  3 |   3
dashdash:   .ascii "--\0"                                      //   3 |  3 |   3
//              |<-- 8 chars -->|<- +8c ->|                    //  ---------  45
                                                               // 110 (tot.) 110

// ==============================================================================
// PADDING: Aligned exactly to 1024 bytes (dd skip=2)
// ==============================================================================
file_end:                               // Physical end of the binary file!
.fill (1024 - (. - elf_header)), 1, 0   // Padding to 1024 bytes for skip=2

// ==============================================================================
// BSS SECTION (RAM only)
// ==============================================================================
buf:                                    // Label at offset 1024, RAM only
.equ bss_end, . + 516                   // Reserve 512 + 4 bytes for the buffer

