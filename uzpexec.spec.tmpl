Name:           uzpexec
Version:        0.94
Release:        1%{?dist}
Summary:        Micro pipe execution and gzip self-executable packager
License:        GPLv2, MIT+1 and CC BY-NC-ND 4.0.
URL:            https://github.com/robang74/uzpexec
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  nasm, gcc, make, gzip, coreutils, git
Requires:       gzip, coreutils
Suggests:       pigz

%description
Self-extracting ELF32 executables in RAM without disk write, uzpack converts
binaries or scripts into gzip compressed self-running files. While uzpexec is
the 512-byte (a single dd block size) assembler-written utility which can also
operate as a standalone binary for executing ELF (otherwise scripts) by STDIN.

This package includes the development sources installed under
%{_datadir}/uzpexec/src/.

%prep
%setup -q

%build
make %{?_smp_mflags}

%install
rm -rf %{buildroot}
make install DESTDIR=%{buildroot} PREFIX=%{_prefix}

%files
%defattr(-,root,root,-)
%{_bindir}/uzpack
%{_bindir}/uzpexec
%{_bindir}/gzcmd.gz.sh
%{_mandir}/man1/uzpack.1*
%{_mandir}/man1/uzpexec.1*
%{_datadir}/uzpack/src/*

%changelog
